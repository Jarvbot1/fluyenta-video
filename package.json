{
  "name": "fluyenta-video",
  "version": "1.0.0",
  "private": true,
  "description": "Fluyenta interview reels (Spanish): Andr\u00e9s Murcia interviewed by Juan, cut into 60-90 s clips in the Fluyenta carousel system. Remotion + a Python prep pipeline.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs FluyentaInterview",
    "render": "node scripts/render.mjs FluyentaInterview out/fluyenta-interview-03.mp4",
    "thumbs": "node scripts/thumbs.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@remotion/elevenlabs": {
      "zod": "4.6.6"
    },
    "@remotion/media": {
      "zod": "4.6.6"
    },
    "@remotion/openai-whisper": {
      "zod": "4.6.6"
    },
    "@remotion/studio": {
      "zod": "4.6.6"
    },
    "@remotion/studio-protocol": {
      "zod": "4.6.6"
    },
    "@remotion/studio-server": {
      "zod": "4.6.6"
    }
  }
