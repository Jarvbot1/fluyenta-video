{
  "name": "fluyenta-video",
  "version": "1.0.0",
  "private": true,
  "description": "Fluyenta interview reels (Spanish): Andrés Murcia interviewed by Juan, cut into 60-90 s clips in the Fluyenta carousel system. Remotion + a Python prep pipeline.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs FluyentaInterview",
    "render": "node scripts/render.mjs FluyentaInterview out/fluyenta-interview-03.mp4",
    "thumbs": "node scripts/thumbs.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.490",
    "@remotion/cli": "4.0.490",
    "@remotion/fonts": "4.0.490",
    "@remotion/renderer": "4.0.490",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.490"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.9.3"
  }
}
